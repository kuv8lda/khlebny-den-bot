# Токен Telegram-бота от @BotFather
BOT_TOKEN="токен"
FSM_DB_PATH=data/fsm.sqlite3

# Панель orders-admin-panel. Пустой PANEL_API_KEY выключает интеграцию:
# бот работает на встроенном каталоге.
PANEL_BASE_URL=http://127.0.0.1:5000
PANEL_API_KEY=
PANEL_TIMEOUT_SECONDS=5
CATALOG_TTL_SECONDS=60
# Интервал опроса событий панели в секундах (положительное число).
EVENTS_POLL_INTERVAL=5


# Владельцы пекарни: Telegram ID через запятую (узнать у @userinfobot).
# Им приходят уведомления о заказах и работает /owner. Пусто — функция выключена.
OWNER_TELEGRAM_IDS=

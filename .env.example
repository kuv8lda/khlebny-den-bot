# Токен Telegram-бота от @BotFather
BOT_TOKEN="токен"
FSM_DB_PATH=data/fsm.sqlite3
# Пусто — использовать FSM_DB_PATH.
ORDERS_DB_PATH=

# Только для docker compose (см. docs/DEPLOY.md):
# PANEL_IMAGE=orders-admin-panel:local
# PANEL_DATA_DIR=/absolute/data/directory/from/panel/image/docs
# PANEL_PORT=5000
# PANEL_HOST_PORT=5000

# Панель orders-admin-panel. Пустой PANEL_API_KEY выключает интеграцию:
# бот работает на встроенном каталоге.
PANEL_BASE_URL=http://127.0.0.1:5000
PANEL_API_KEY=
PANEL_TIMEOUT_SECONDS=5
# Общий секрет для push от панели: не менее 32 байт; пусто — приёмник выключен.
CATALOG_PUSH_TOKEN=
CATALOG_PUSH_HOST=127.0.0.1
CATALOG_PUSH_PORT=8081
# TTL автономного CatalogProvider; на push-обновления не влияет.
CATALOG_TTL_SECONDS=60
# Интервал опроса событий панели в секундах (положительное число).
EVENTS_POLL_INTERVAL=5


# Владельцы пекарни: Telegram ID через запятую (узнать у @userinfobot).
# Им приходят уведомления о заказах, работает /owner и не применяется лимит заказов.
# Пусто — владельцы не назначены.
OWNER_TELEGRAM_IDS=
